# Copy to .env and change the secrets. .env is git-ignored.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=logivault
DB_USERNAME=logivault
DB_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-base64-at-least-32-bytes

# First ADMIN account, created by the Flyway seed migration
LOGIVAULT_ADMIN_EMAIL=admin@logivault.local
LOGIVAULT_ADMIN_PASSWORD=change-me-too

# Comma-separated, empty = no CORS
LOGIVAULT_CORS_ALLOWED_ORIGINS=
